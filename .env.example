# ==============================================================================
# YouthEscalateBench — LLM API Keys & Provider Configuration
# ==============================================================================
# Reference: Artificial Analysis (https://artificialanalysis.ai) for Quality,
# Cost ($ / 1M tokens), Latency, and Throughput (tokens/s) benchmarks.
#
# Lower-cost, high-throughput models are set as defaults below for cost efficiency,
# with flagship and frontier models documented in comments for easy selection.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------------------
# 2. Anthropic
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ------------------------------------------------------------------------------
# 3. Google Gemini
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 4. xAI (Grok)
# ------------------------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# ------------------------------------------------------------------------------
# 5. Qwen (Alibaba Cloud / DashScope)
# ------------------------------------------------------------------------------
DASHSCOPE_API_KEY=
# QWEN_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus

# ------------------------------------------------------------------------------
# 6. GLM (Zhipu AI / BigModel)
# ------------------------------------------------------------------------------
# Default: glm-4-flash (Free / ultra-low cost, high throughput)
GLM_API_KEY=
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GLM_MODEL=glm-4-flash

# ------------------------------------------------------------------------------
# 7. Groq (Ultra-Fast LPU Inference)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
# GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 8. DeepSeek
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=DeepSeek-V4-Pro-0813

# ------------------------------------------------------------------------------
# 9. Mistral AI
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 10. Cohere
# ------------------------------------------------------------------------------
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# ------------------------------------------------------------------------------
# 11. OpenRouter (All 19 Active Free Models: https://openrouter.ai/models?variant=free)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Multi-model Free OpenRouter usage (Zero inference cost):
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-content-safety:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,z-ai/glm-5.2:free,minimax/minimax-m3:free,minimax/minimax-m2.7:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,inclusionai/ling-3.0-flash-fin:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free,thinkingmachines/inkling:free,poolside/laguna-s-2.1:free,poolside/laguna-xs-2.1:free,openrouter/free







# ------------------------------------------------------------------------------
# 12. Hugging Face (Open Moderation Guardrails)
# ------------------------------------------------------------------------------
HF_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-Guard-3-1B

# ------------------------------------------------------------------------------
# 13. Local Models via Ollama or vLLM (Zero API Cost, Fully Private)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 14. Requesty.ai (Free Models: https://www.requesty.ai/models/free)
# ------------------------------------------------------------------------------
REQUESTY_API_KEY=
REQUESTY_MODEL=google/gemma-4-31b-it

# Multi-model Free Requesty usage (Zero inference cost):
# REQUESTY_MODELS=google/gemma-4-31b-it,nvidia/nemotron-3.5-content-safety,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-nano-30b-a3b,mistral/leanstral-1-5,nvidia/muse-glimmer-30b,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b,novita/inclusionai/ling-3.0-tiny,poolside/laguna-m.1,poolside/laguna-xs.2

# ------------------------------------------------------------------------------
# Global Default & Routing Settings
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 14. Slang & Colloquial Vocabulary APIs
# ------------------------------------------------------------------------------
URBAN_DICTIONARY_API_URL=https://unofficialurbandictionaryapi.com/
ENABLE_URBAN_DICTIONARY_QUERY=true
