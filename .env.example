# ==============================================================================
# YouthEscalateBench — LLM API Keys & Provider Configuration
# ==============================================================================
# Reference: Artificial Analysis (https://artificialanalysis.ai) for Quality,
# Cost ($ / 1M tokens), Latency, and Throughput (tokens/s) benchmarks.
#
# Lower-cost, high-throughput models are set as defaults below for cost efficiency,
# with flagship and frontier models documented in comments for easy selection.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI
# ------------------------------------------------------------------------------
# Default: gpt-4o-mini (Artificial Analysis: $0.15 in / $0.60 out per 1M tokens, Quality ~74)
# Alternative High-Intelligence / Frontier: gpt-4o, gpt-5.6-luna, o3-mini, o1-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL=o3-mini

# ------------------------------------------------------------------------------
# 2. Anthropic
# ------------------------------------------------------------------------------
# Default: claude-3-5-haiku-20241022 (Artificial Analysis: $0.25 in / $1.25 out per 1M tokens, ~75 tok/s)
# Alternative High-Intelligence / Frontier: claude-3-5-sonnet-20241022, claude-sonnet-5, claude-3-opus-20240229
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 3. Google Gemini
# ------------------------------------------------------------------------------
# Default: gemini-1.5-flash (Artificial Analysis: $0.075 in / $0.30 out per 1M tokens — lowest frontier cost)
# Alternative High-Throughput / Frontier: gemini-1.5-flash-8b ($0.0375/1M), gemini-2.0-flash, gemini-1.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash-8b
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. xAI (Grok)
# ------------------------------------------------------------------------------
# Default: grok-2-latest (Artificial Analysis: $2.00 in / $10.00 out per 1M tokens)
# Alternative High-Capability / Vision: grok-2-1212, grok-2-vision-1212, grok-3, grok-3-mini, grok-beta
XAI_API_KEY=
# GROK_API_KEY=your_xai_or_grok_api_key_here
XAI_MODEL=grok-2-latest
# GROK_MODEL=grok-2-latest
# XAI_MODEL=grok-2-1212
# XAI_MODEL=grok-2-vision-1212
# XAI_MODEL=grok-3
# XAI_MODEL=grok-3-mini
# XAI_MODEL=grok-beta

# ------------------------------------------------------------------------------
# 5. Qwen (Alibaba Cloud / DashScope)
# ------------------------------------------------------------------------------
# Default: qwen-plus (Artificial Analysis: $0.11 in / $0.28 out per 1M tokens)
# Alternative High-Capability / Open: qwen-turbo ($0.04/1M), qwen-max, qwen2.5-72b-instruct, qwen2.5-coder-32b-instruct, qwq-32b-preview
DASHSCOPE_API_KEY=
# QWEN_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus
# QWEN_MODEL=qwen-turbo
# QWEN_MODEL=qwen-max
# QWEN_MODEL=qwen2.5-72b-instruct
# QWEN_MODEL=qwen2.5-32b-instruct
# QWEN_MODEL=qwq-32b-preview

# ------------------------------------------------------------------------------
# 6. GLM (Zhipu AI / BigModel)
# ------------------------------------------------------------------------------
# Default: glm-4-flash (Free tier / ultra-low cost $0.0001/1k tokens, high throughput)
# Alternative High-Capability: glm-4-plus ($0.007/1k), glm-4-air ($0.001/1k), glm-4-long (1M context), glm-zero-preview
GLM_API_KEY=
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GLM_MODEL=glm-4-flash
# GLM_MODEL=glm-4-plus
# GLM_MODEL=glm-4-air
# GLM_MODEL=glm-4-long
# GLM_MODEL=glm-zero-preview

# ------------------------------------------------------------------------------
# 7. Groq (Ultra-Fast LPU Inference)
# ------------------------------------------------------------------------------
# Default: llama-3.1-8b-instant (Artificial Analysis: $0.05 in / $0.08 out per 1M tokens, ~800+ tok/s)
# Alternative High-Capability: llama-3.3-70b-versatile ($0.59/1M), llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=
# GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-70b-versatile
# GROQ_MODEL=mixtral-8x7b-32768
# GROQ_MODEL=gemma2-9b-it
# GROQ_MODEL=llama3-70b-8192

# ------------------------------------------------------------------------------
# 8. DeepSeek
# ------------------------------------------------------------------------------
# Default: deepseek-chat (DeepSeek-V3, Artificial Analysis: $0.14 in / $0.28 out per 1M tokens)
# Alternative Reasoning: deepseek-reasoner (DeepSeek-R1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-reasoner

# ------------------------------------------------------------------------------
# 9. Mistral AI
# ------------------------------------------------------------------------------
# Default: mistral-small-latest (Artificial Analysis: $0.10 in / $0.30 out per 1M tokens)
# Alternative Efficient: open-mistral-nemo ($0.15/1M), ministral-8b-latest, mistral-large-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MODEL=open-mistral-nemo
# MISTRAL_MODEL=mistral-large-latest

# ------------------------------------------------------------------------------
# 10. Cohere
# ------------------------------------------------------------------------------
# Default: command-r-08-2024 (Artificial Analysis: $0.15 in / $0.60 out per 1M tokens)
# Alternative High-Capability: command-r-plus-08-2024 ($2.50 in / $10.00 out)
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
# COHERE_MODEL=command-r-plus-08-2024

# ------------------------------------------------------------------------------
# 11. OpenRouter
# ------------------------------------------------------------------------------
# Default: meta-llama/llama-3.3-70b-instruct:free (High-intelligence, zero API cost)
# Alternative Free Models:
#   - meta-llama/llama-3.1-8b-instruct:free
#   - meta-llama/llama-3.2-3b-instruct:free
#   - google/gemini-2.0-flash-exp:free
#   - google/gemini-2.0-flash-thinking-exp:free
#   - deepseek/deepseek-r1:free
#   - deepseek/deepseek-chat:free
#   - mistralai/mistral-7b-instruct:free
#   - qwen/qwen-2.5-72b-instruct:free
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free


# ------------------------------------------------------------------------------
# 12. Hugging Face (Open Moderation Guardrails)
# ------------------------------------------------------------------------------
# Default: meta-llama/Llama-Guard-3-1B (Lightweight edge safeguard)
# Alternative: meta-llama/Llama-Guard-3-8B, allenai/wildguard, unitary/toxic-bert
HF_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-Guard-3-1B
# HUGGINGFACE_MODEL=meta-llama/Llama-Guard-3-8B

# ------------------------------------------------------------------------------
# 13. Local Models via Ollama or vLLM (Zero API Cost, Fully Private)
# ------------------------------------------------------------------------------
# Default: llama3.2:3b (Ultra-fast, low memory footprint)
# Alternative: llama3.2:1b, llama3.1:8b, qwen2.5:7b, gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# Global Default & Routing Settings
# ------------------------------------------------------------------------------
# Mode options:
# - "auto" (default): auto-selects first configured provider in priority order
# - "ensemble": queries all detected providers for cross-model consensus
# - Or specify explicit provider: "openai", "anthropic", "gemini", "xai", "qwen", "glm", "groq", "deepseek", "mistral", "ollama"
DEFAULT_LLM_PROVIDER=auto
